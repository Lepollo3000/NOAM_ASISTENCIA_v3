@page "/account/login"
@layout AuthenticationLayout

@inject IAccountManagement AccountManager
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>


<div class="row justify-content-center">
    <div class="col-md-6">
        <h1 class="h3">Inicio de Sesión</h1>

        <AuthorizeView>
            <Authorized>
                <div class="alert alert-success">Tiene su sesión iniciada como: @(context.User.Identity?.Name).</div>
            </Authorized>

            <NotAuthorized>
                <MudForm @ref="@form" Model="@request" Validation="@requestValidator.Validation">
                    <div class="input-group justify-content-center mb-3">
                        <MudTextField @bind-Value="@request.Username" For="@(() => request.Username)"
                                      Label="@request.GetDisplayName(model => model.Username)"
                                      HelperText="@request.GetDisplayDescription(model => model.Username)"
                                      AdornmentColor="@TextInputDefaults.Color"
                                      Variant="@TextInputDefaults.Variant"
                                      InputType="@TextInputDefaults.InputType"
                                      Immediate="@TextInputDefaults.Inmediate" />
                    </div>

                    <div class="input-group justify-content-center mb-3">
                        <MudTextField @bind-Value="@request.Password" For="@(() => request.Password)"
                                      Label="@request.GetDisplayName(model => model.Password)"
                                      HelperText="@request.GetDisplayDescription(model => model.Password)"
                                      AdornmentColor="@passwordConfiguration.Color"
                                      Variant="@passwordConfiguration.Variant"
                                      InputType="@passwordConfiguration.InputType"
                                      Immediate="@passwordConfiguration.Inmediate"
                                      Adornment="@passwordConfiguration.Adornment"
                                      AdornmentIcon="@passwordConfiguration.Icon"
                                      OnAdornmentClick="@passwordConfiguration.FieldIconPressed" />
                    </div>

                    <hr />

                    <div class="input-group justify-content-between mb-3">
                        <MudButton Href="/" Color="Color.Secondary"
                                   Variant="Variant.Filled" StartIcon="fa fa-angle-left">
                            Regresar
                        </MudButton>

                        <MudButton OnClick="@(async () => await SubmitAsync())" Color="Color.Primary"
                                   Variant="Variant.Filled" EndIcon="fa fa-check">
                            Iniciar Sesión
                        </MudButton>
                    </div>
                </MudForm>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
