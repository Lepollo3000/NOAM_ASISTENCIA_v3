@page "/account/login"
@layout AuthenticationLayout

@inject IAccountService AccountManager
@inject NavigationManager NavigationManager

<PageTitle>Login</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-12">
        <h1 class="h3">Inicio de Sesión</h1>

        <AuthorizeView>
            <Authorized>
                <div class="alert alert-success">Tiene su sesión iniciada como: @(context.User.Identity?.Name).</div>
            </Authorized>

            <NotAuthorized>
                <MudForm @ref="@form" Model="@_request" Validation="@_requestValidator.Validation">
                    <div class="input-group justify-content-center mb-3">
                        <MudTextField @bind-Value="@_request.Username" For="@(() => _request.Username)"
                                      Label="@_request.GetDisplayName(model => model.Username)"
                                      HelperText="@_request.GetDisplayDescription(model => model.Username)"
                                      AdornmentColor="@TextInputDefaults.Color"
                                      Variant="@TextInputDefaults.Variant"
                                      InputType="@TextInputDefaults.InputType"
                                      Immediate="@TextInputDefaults.Inmediate" />
                    </div>

                    <div class="input-group justify-content-center mb-3">
                        <MudTextField @bind-Value="@_request.Password" For="@(() => _request.Password)"
                                      Label="@_request.GetDisplayName(model => model.Password)"
                                      HelperText="@_request.GetDisplayDescription(model => model.Password)"
                                      AdornmentColor="@_passwordConfiguration.Color"
                                      Variant="@_passwordConfiguration.Variant"
                                      InputType="@_passwordConfiguration.InputType"
                                      Immediate="@_passwordConfiguration.Inmediate"
                                      Adornment="@_passwordConfiguration.Adornment"
                                      AdornmentIcon="@_passwordConfiguration.Icon"
                                      OnAdornmentClick="@_passwordConfiguration.FieldIconPressed" />
                    </div>

                    <hr />

                    <div class="input-group justify-content-end mb-3">
                        <MudButton OnClick="@(async () => await SubmitAsync())" Color="Color.Primary"
                                   Variant="Variant.Filled" EndIcon="fa fa-check">
                            Iniciar Sesión
                        </MudButton>
                    </div>
                </MudForm>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>
