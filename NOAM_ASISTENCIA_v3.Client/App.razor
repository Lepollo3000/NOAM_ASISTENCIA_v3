<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <Authorizing>
                <p class="alert alert-info" role="alert">
                    Autorización en proceso. Por favor espere...
                </p>
            </Authorizing>

            <NotAuthorized>
                @if (context.User.Identity?.IsAuthenticated != true)
                {
                    <RedirectToLogin />
                }
                else
                {
                    <p role="alert">
                        No se está autorizado para acceder a este recurso. Inicie sesión con otra cuenta o
                        contacte a un administrador.
                    </p>
                }
            </NotAuthorized>
        </AuthorizeRouteView>

        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>

    <NotFound>
        <PageTitle>No encontrado</PageTitle>

        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Lo sentimos, no se encontró ningún recurso en esta dirección.</p>
        </LayoutView>
    </NotFound>
</Router>

<MudThemeProvider Theme="CurrentTheme" />

@code {
    private MudTheme CurrentTheme { get; set; } = new()
        {
            Palette = new()
            {
                Black = Colors.Shades.Black,

                Primary = Colors.Blue.Accent3,
                Secondary = Colors.Grey.Darken1,
                Warning = Colors.Amber.Accent3,

                Background = Colors.Grey.Lighten3,
                BackgroundGrey = Colors.Grey.Lighten1,
                DrawerBackground = Colors.BlueGrey.Darken4,
                AppbarBackground = Colors.BlueGrey.Darken3,

                Surface = Colors.BlueGrey.Lighten5,

                TextPrimary = Colors.Grey.Darken4,
                TextSecondary = Colors.Grey.Darken3,
                DrawerText = Colors.Grey.Lighten5,
                AppbarText = Colors.Grey.Lighten5,

                DrawerIcon = Colors.Grey.Lighten5,
                TableLines = Colors.BlueGrey.Lighten4
            }
        };
}
