<MudTextField @bind-Value="Value" For="@For"
              AdornmentColor="Color.Primary" OnlyValidateIfDirty="true"
              Variant="Variant.Outlined" InputType="@inputType"
              Adornment="Adornment.End" AdornmentIcon="@passwordIcon"
              OnAdornmentClick="FieldIconPressed" AdornmentAriaLabel="Show Password"
              Label="@Label" HelperText="@Description" TextChanged="UpdateValue" />
