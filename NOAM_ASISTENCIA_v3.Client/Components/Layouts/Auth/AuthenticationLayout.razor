@inherits LayoutComponentBase

<MudLayout>
    <CascadingValue Value="this">
        <MudMainContent>
            <MudContainer Class="container">
                <div class="row justify-content-center">
                    <MudCard Class="col-lg-4 col-md-6 col-sm-8 col-10 align-content-center" Style="min-height: 80vh;">
                        <MudCardContent>
                            @Body
                        </MudCardContent>
                    </MudCard>
                </div>
            </MudContainer>
        </MudMainContent>
    </CascadingValue>
</MudLayout>
