@inherits LayoutComponentBase

<MudLayout>
    <CascadingValue Value="this">
        <MudMainContent>
            <MudContainer Class="py-md-3 p-2">
                <MudCard Class="p-md-3 p-2" Style="min-height: 80vh;">
                    <MudCardContent>
                        @Body
                    </MudCardContent>
                </MudCard>
            </MudContainer>
        </MudMainContent>
    </CascadingValue>
</MudLayout>
